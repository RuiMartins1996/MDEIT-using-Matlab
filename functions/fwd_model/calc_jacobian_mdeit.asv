function y = vec_jacobian_product_v2(img, x, A, w, select_sensor_axis, verbose)
% Computes w'*J or J^T*w

img.elem_data = x;
mu0 = img.fwd_model.mu0;

numNodes = size(img.fwd_model.nodes,1);
numElems = size(img.fwd_model.elems,1);
